# Neon Postgres connection string. Written by `npx neon@latest init` (see README).
DATABASE_URL=

# Neon Object Storage (product photos). Written by `neon deploy` / `neon env pull`
# once the product-images bucket in neon.ts exists. Add the same four to Vercel.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# At least 32 random characters. Signs the admin session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
SESSION_SECRET=

# Public site address, no trailing slash. Optional on Vercel (falls back to the
# production .vercel.app address). Example: https://earthinterior.pk
SITE_URL=
